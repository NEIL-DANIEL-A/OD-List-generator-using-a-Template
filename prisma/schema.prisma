generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id        String         @id @default(uuid())
  name      String
  date      DateTime
  venue     String?
  createdAt DateTime       @default(now())
  files     UploadedFile[]
}

model UploadedFile {
  id         String   @id @default(uuid())
  filename   String
  filepath   String
  uploadedAt DateTime @default(now())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id])
}

model GeneratedPdf {
  id            String   @id @default(uuid())
  filename      String
  filepath      String
  eventId       String
  eventName     String
  createdAt     DateTime @default(now())
  participantCount Int
}
